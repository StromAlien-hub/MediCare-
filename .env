# ─────────────────────────────────────
#  MediCare+ Backend Environment Config
#  Copy this to .env and fill values
# ─────────────────────────────────────

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medicare_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT (use a long random string)
JWT_SECRET=change_this_to_long_random_string_minimum_32_chars

# Anthropic Claude API key
# Get free key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
